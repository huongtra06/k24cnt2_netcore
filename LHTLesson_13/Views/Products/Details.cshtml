@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="products">

    <h1>Chi tiết sản phẩm</h1>

    <div class="product">

        <div class="product-img">
            Hình ảnh sản phẩm
        </div>

        <h3>Mô hình đồ chơi</h3>

        <p>350.000 VNĐ</p>

        <p>
            Đây là sản phẩm mô hình đồ chơi
            dành cho người yêu thích sưu tầm.
        </p>

        <a asp-controller="Products"
           asp-action="Index">
            Quay lại danh sách
        </a>

    </div>

</div>