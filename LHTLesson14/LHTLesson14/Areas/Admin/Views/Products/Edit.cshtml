@model LHTLesson14.Models.Product
@{ ViewData["Title"]="Sửa sản phẩm"; }
<div class="admin-card form-card"><h2>Sửa sản phẩm</h2><p>Cập nhật thông tin sản phẩm #@Model.Id.</p>
<form asp-action="Edit" method="post"><input asp-for="Id" type="hidden" /><input asp-for="CreatedDate" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="form-grid"><div><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="text-danger"></span></div><div><label asp-for="CategoryId"></label><select asp-for="CategoryId" asp-items="ViewBag.Categories"></select></div>
<div><label asp-for="Price"></label><input asp-for="Price" type="number" step="1000" /></div><div><label asp-for="SalePrice"></label><input asp-for="SalePrice" type="number" step="1000" /></div>
<div><label>Tên file ảnh</label><input asp-for="Image" /></div><div><label>Trạng thái</label><select asp-for="Status"><option value="1">Đang bán</option><option value="0">Ẩn</option></select></div>
<div class="full"><label asp-for="Description"></label><textarea asp-for="Description"></textarea></div></div>
<div class="form-actions"><button class="admin-btn">Lưu thay đổi</button><a class="btn-light-custom" asp-action="Index">Hủy</a></div></form></div>
