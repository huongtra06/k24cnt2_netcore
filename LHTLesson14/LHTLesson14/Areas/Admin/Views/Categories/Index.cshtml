@model IEnumerable<LHTLesson14.Models.Category>
@{ ViewData["Title"]="Quản lý danh mục"; }
<div class="admin-card">
<div class="card-heading"><div><h2>Danh mục sản phẩm</h2><p>Thêm, sửa và quản lý trạng thái danh mục.</p></div><a class="admin-btn" asp-action="Create">+ Thêm danh mục</a></div>
<form class="admin-filter" method="get"><input name="keyword" value="@ViewBag.Keyword" placeholder="Tìm danh mục..." /><button class="admin-btn">Tìm kiếm</button></form>
<div class="table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th>Tên danh mục</th><th>Số sản phẩm</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var c in Model){<tr><td>#@c.Id</td><td><strong>@c.Name</strong><small>@c.Description</small></td><td>@c.Products.Count</td><td><span class="status @(c.Status==1?"on":"off")">@(c.Status==1?"Hoạt động":"Ẩn")</span></td><td class="actions"><a asp-action="Edit" asp-route-id="@c.Id">Sửa</a><form asp-action="ToggleStatus" asp-route-id="@c.Id" method="post"><button>Đổi trạng thái</button></form><a class="danger" asp-action="Delete" asp-route-id="@c.Id">Xóa</a></td></tr>}
</tbody></table></div></div>
