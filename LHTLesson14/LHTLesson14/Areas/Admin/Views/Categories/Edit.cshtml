@model LHTLesson14.Models.Category
@{ ViewData["Title"]="Sửa danh mục"; }
<div class="admin-card form-card"><h2>Sửa danh mục</h2><p>Cập nhật thông tin danh mục.</p>
<form asp-action="Edit" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="text-danger"></span>
<label asp-for="Description"></label><textarea asp-for="Description"></textarea>
<label>Trạng thái</label><select asp-for="Status"><option value="1">Hoạt động</option><option value="0">Ẩn</option></select>
<div class="form-actions"><button class="admin-btn">Lưu thay đổi</button><a class="btn-light-custom" asp-action="Index">Hủy</a></div>
</form></div>
