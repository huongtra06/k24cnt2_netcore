@model IEnumerable<LHTLesson14.Models.Product>
@{ ViewData["Title"]="Tìm kiếm bánh"; Layout="~/Views/Shared/_LHTLayoutHome.cshtml"; }
<section class="page-title"><h1>Tìm kiếm bánh</h1><p>Tìm theo tên, mô tả hoặc danh mục</p></section><form asp-action="Search" method="get" class="search-box"><div class="search-input"><input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Nhập từ khóa bất kỳ..."/><button type="submit">Tìm kiếm</button></div></form>@if(!string.IsNullOrWhiteSpace((string?)ViewBag.Keyword)){<p>Kết quả cho: <strong>@ViewBag.Keyword</strong> — @Model.Count() bánh</p>}<div class="product-grid">@foreach(var x in Model){<article class="product-card"><div class="product-image"><img src="~/images/@x.Image" alt="@x.Name"/></div><div class="product-content"><span class="product-category">@x.Category?.Name</span><h3>@x.Name</h3><p class="product-description">@x.Description</p><div class="product-bottom"><span class="price">@((x.SalePrice>0?x.SalePrice:x.Price).ToString("N0")) đ</span><a class="btn-product" asp-action="Details" asp-route-id="@x.Id">Xem bánh</a></div></div></article>}</div>@if(!Model.Any()){<p>Không tìm thấy mẫu bánh.</p>}
