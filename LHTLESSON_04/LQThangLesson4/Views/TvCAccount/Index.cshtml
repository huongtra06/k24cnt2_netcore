@model List<LQThangLesson4.Models.TvCAccount>

@{
    ViewData["Title"] = "Danh sach tai khoan";
}

<div class="container py-5">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="fw-bold mb-1">
                Danh sách tài khoản
            </h1>

            <p class="text-muted mb-0">
                Quản lý thông tin tài khoản trong hệ thống
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-success px-4">

            + Thêm tài khoản

        </a>

    </div>


    <!-- THONG BAO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- SEARCH -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <div class="col-md-7">

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Tìm theo tên, email, số điện thoại..." />

                    </div>

                    <div class="col-md-3">

                        <select name="gender"
                                class="form-select">

                            <option value="">
                                -- Tất cả giới tính --
                            </option>

                            @if (ViewBag.Gender == "Nam")
                            {
                                <option value="Nam" selected>
                                    Nam
                                </option>
                            }
                            else
                            {
                                <option value="Nam">
                                    Nam
                                </option>
                            }

                            @if (ViewBag.Gender == "Nu")
                            {
                                <option value="Nu" selected>
                                    Nữ
                                </option>
                            }
                            else
                            {
                                <option value="Nu">
                                    Nữ
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            Tìm kiếm

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- DANH SACH -->

    <div class="row">

        @if (Model.Count == 0)
        {
            <div class="col-12">

                <div class="alert alert-warning text-center">

                    Không tìm thấy tài khoản phù hợp.

                </div>

            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">

                    <div class="card account-card h-100 shadow-sm">

                        <div class="card-body">

                            <!-- AVATAR -->

                            <div class="text-center mb-3">

                                <img src="@item.Avatar"
                                     alt="@item.Name"
                                     class="account-avatar rounded-circle" />

                            </div>


                            <!-- INFO -->

                            <div class="text-center">

                                <h4 class="fw-bold">
                                    @item.Name
                                </h4>

                                <p class="text-muted mb-3">
                                    @item.Bio
                                </p>

                            </div>

                            <hr />

                            <div class="account-info">

                                <p>
                                    <strong>Email:</strong>
                                    @item.Email
                                </p>

                                <p>
                                    <strong>SĐT:</strong>
                                    @item.Phone
                                </p>

                                <p>
                                    <strong>Địa chỉ:</strong>
                                    @item.Address
                                </p>

                                <p>
                                    <strong>Giới tính:</strong>
                                    @item.Gender
                                </p>

                            </div>


                            <!-- BUTTON -->

                            <div class="d-grid gap-2 mt-4">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-primary">

                                    Xem Profile

                                </a>

                                <div class="row g-2">

                                    <div class="col-6">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning w-100">

                                            Sửa

                                        </a>

                                    </div>

                                    <div class="col-6">

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger w-100">

                                            Xóa

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }
        }

    </div>

</div>