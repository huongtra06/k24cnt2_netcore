@model LQThangLesson4.Models.TvCAccount

@{
    ViewData["Title"] = "Profile";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow profile-card">

                <div class="card-body p-5">

                    <div class="text-center">

                        <img src="@Model.Avatar"
                             alt="@Model.Name"
                             class="profile-avatar rounded-circle mb-3" />

                        <h2 class="fw-bold">
                            @Model.Name
                        </h2>

                        <p class="text-muted">
                            @Model.Bio
                        </p>

                    </div>

                    <hr class="my-4" />

                    <div class="row g-4">

                        <div class="col-md-6">

                            <label class="text-muted">
                                Email
                            </label>

                            <div class="fw-bold">
                                @Model.Email
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="text-muted">
                                Số điện thoại
                            </label>

                            <div class="fw-bold">
                                @Model.Phone
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="text-muted">
                                Địa chỉ
                            </label>

                            <div class="fw-bold">
                                @Model.Address
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="text-muted">
                                Giới tính
                            </label>

                            <div class="fw-bold">
                                @Model.Gender
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="text-muted">
                                Ngày sinh
                            </label>

                            <div class="fw-bold">
                                @Model.Birthday.ToString("dd/MM/yyyy")
                            </div>

                        </div>

                        <div class="col-md-12">

                            <label class="text-muted">
                                Giới thiệu
                            </label>

                            <div class="fw-bold">
                                @Model.Bio
                            </div>

                        </div>

                    </div>

                    <div class="d-flex gap-2 mt-5">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-warning">

                            Sửa thông tin

                        </a>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            Quay lại

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>