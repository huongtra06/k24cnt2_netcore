@model LHTraLesson12.Models.Product
@{ ViewData["Title"] = "Sửa sản phẩm"; }
<div class="form-card"><h1>Sửa sản phẩm</h1><form asp-action="Edit" method="post"><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="CreatedDate" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-4"><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select><span asp-validation-for="CategoryId" class="text-danger"></span></div><div class="col-12"><label asp-for="Image" class="form-label"></label><input asp-for="Image" class="form-control" /></div><div class="col-md-4"><label asp-for="Price" class="form-label"></label><input asp-for="Price" type="number" step="0.01" class="form-control" /><span asp-validation-for="Price" class="text-danger"></span></div><div class="col-md-4"><label asp-for="SalePrice" class="form-label"></label><input asp-for="SalePrice" type="number" step="0.01" class="form-control" /><span asp-validation-for="SalePrice" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option value="1">Đang bán</option><option value="0">Ngừng bán</option></select></div><div class="col-12"><label asp-for="Descriptions" class="form-label"></label><textarea asp-for="Descriptions" rows="4" class="form-control"></textarea></div></div><div class="form-actions"><button class="btn btn-dark rounded-pill px-4">Lưu</button><a asp-action="Index" class="btn btn-light rounded-pill">Hủy</a></div></form></div>
