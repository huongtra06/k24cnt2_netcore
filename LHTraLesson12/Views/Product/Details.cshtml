@model LHTraLesson12.Models.Product
@{ ViewData["Title"] = Model.Name; }
<div class="detail-card"><div class="row g-5 align-items-center"><div class="col-lg-6"><div class="detail-photo">@if (!string.IsNullOrWhiteSpace(Model.Image)) { <img src="@Model.Image" alt="@Model.Name" /> } else { <span>LHTra</span> }</div></div><div class="col-lg-6"><small>@Model.Category?.Name</small><h1>@Model.Name</h1><div class="detail-price">@((Model.SalePrice > 0 ? Model.SalePrice : Model.Price).ToString("N0")) ₫</div>@if (Model.SalePrice > 0 && Model.SalePrice < Model.Price) { <div class="old-price">@Model.Price.ToString("N0") ₫</div> }<p class="detail-description">@Model.Descriptions</p><div class="status-line">@(Model.Status == 1 ? "Đang bán" : "Ngừng bán")</div><div class="form-actions"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark rounded-pill px-4">Sửa</a><a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill">Xóa</a><a asp-action="Index" class="btn btn-light rounded-pill">Quay lại</a></div></div></div></div>
