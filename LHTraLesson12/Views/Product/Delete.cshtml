@model LHTraLesson12.Models.Product
@{ ViewData["Title"] = "Xóa sản phẩm"; }
<div class="confirm-card"><div class="confirm-photo">@if (!string.IsNullOrWhiteSpace(Model.Image)) { <img src="@Model.Image" alt="@Model.Name" /> } else { <span>LHTra</span> }</div><h1>Xóa sản phẩm</h1><h4>@Model.Name</h4><p>@Model.Category?.Name</p><form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" /><button class="btn btn-danger rounded-pill px-4">Xóa</button><a asp-action="Index" class="btn btn-light rounded-pill">Hủy</a></form></div>
