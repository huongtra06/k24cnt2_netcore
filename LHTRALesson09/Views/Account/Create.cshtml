@model Account
@{
    ViewData["Title"] = "Create Account";
}
<div class="page-title">
    <div><span class="eyebrow">STEP 1</span><h1>Create Account</h1><p>Nhập thông tin tài khoản mới.</p></div>
</div>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="card form-card">
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <a class="btn light" asp-action="Index">Back to List</a>
        <button class="btn primary" type="submit">Create</button>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
