@model LHT2410900076_exam.Models.LHTEmployee

@{
    ViewData["Title"] = "Sửa sinh viên";
}

<div class="container mt-4">
    <h1>Sửa sinh viên</h1>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="LHTName" class="form-label">Họ và tên</label>
                    <input asp-for="LHTName" class="form-control" />
                    <span asp-validation-for="LHTName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="LHTGender" class="form-label">Giới tính</label>
                    <input asp-for="LHTGender" class="form-control" />
                    <span asp-validation-for="LHTGender" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="LHTBirthDay" class="form-label">Ngày sinh</label>
                    <input asp-for="LHTBirthDay" type="date" class="form-control" />
                    <span asp-validation-for="LHTBirthDay" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="LHTEmail" class="form-label">Email</label>
                    <input asp-for="LHTEmail" type="email" class="form-control" />
                    <span asp-validation-for="LHTEmail" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="LHTPhone" class="form-label">Số điện thoại</label>
                    <input asp-for="LHTPhone" class="form-control" />
                    <span asp-validation-for="LHTPhone" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="LHTActive" class="form-check-input" />
                    <label asp-for="LHTActive" class="form-check-label">Đang hoạt động</label>
                </div>

                <button type="submit" class="btn btn-primary">Lưu</button>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
