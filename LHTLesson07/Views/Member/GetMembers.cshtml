@{
    ViewData["Title"] = "Danh sách thành viên";
}

<h2>Danh sách thành viên</h2>

<a asp-controller="Member"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Thêm thành viên
</a>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Mã thành viên</th>
            <th>Username</th>
            <th>Họ và tên</th>
            <th>Password</th>
            <th>Email</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var m in ViewBag.members)
        {
            <tr>
                <td>@m.MemberId</td>
                <td>@m.Username</td>
                <td>@m.Fullname</td>
                <td>@m.Password</td>
                <td>@m.Email</td>
            </tr>
        }

    </tbody>

</table>