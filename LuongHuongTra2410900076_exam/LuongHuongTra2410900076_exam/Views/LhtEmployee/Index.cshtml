@model IEnumerable<LhtEmployee>
@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Danh sách sinh viên</h2>
    <a asp-action="Create" class="btn btn-primary">Thêm sinh viên</a>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-primary">
            <tr>
                <th>Họ và tên</th>
                <th>Giới tính</th>
                <th>Ngày sinh</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th>Hoạt động</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LhtName</td>
                <td>@item.LhtGender</td>
                <td>@item.LhtBirthDay?.ToString("dd/MM/yyyy")</td>
                <td>@item.LhtEmail</td>
                <td>@item.LhtPhone</td>
                <td>@(item.LhtActive ? "Có" : "Không")</td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Xem</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
