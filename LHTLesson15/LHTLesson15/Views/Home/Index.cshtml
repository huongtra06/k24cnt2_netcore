@{
    ViewData["Title"] = "Trang chủ";
}

<div class="hero-card p-4 p-md-5 mb-4 rounded-4 shadow-sm">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-success-subtle text-success mb-2">ASP.NET Core MVC</span>
            <h1 class="display-6 fw-bold">Thực hành Session &amp; TempData</h1>
            <p class="lead mb-4">
                LHTLesson15 minh họa cách cấu hình Session, lưu dữ liệu theo người dùng
                và truyền thông báo qua Redirect bằng TempData.
            </p>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }

            <div class="d-flex flex-wrap gap-2">
                @if (Context.Session.GetString("username") == null)
                {
                    <a class="btn btn-success" asp-controller="Home" asp-action="Login">
                        Đăng nhập
                    </a>
                }
                <a class="btn btn-outline-success" asp-controller="Home" asp-action="TestTempData">
                    Thử TempData
                </a>
            </div>
        </div>

        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="info-card bg-white p-4 rounded-4 shadow-sm">
                <h5 class="fw-bold">Session hiện tại</h5>

                @if (Context.Session.GetString("username") != null)
                {
                    <p class="mb-0">
                        Người dùng:
                        <strong>@Context.Session.GetString("username")</strong>
                    </p>
                }
                else
                {
                    <p class="text-muted mb-0">Chưa có người dùng đăng nhập.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="icon-box mb-3">🔐</div>
                <h4 class="fw-bold">Session</h4>
                <p>
                    Session dùng để lưu dữ liệu của từng người dùng giữa nhiều request,
                    ví dụ thông tin đăng nhập.
                </p>
                <code>HttpContext.Session.SetString("username", username);</code>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="icon-box mb-3">📢</div>
                <h4 class="fw-bold">TempData</h4>
                <p>
                    TempData phù hợp để truyền thông báo từ request hiện tại sang request
                    tiếp theo, đặc biệt khi dùng Redirect.
                </p>
                <code>TempData["Success"] = "Thành công!";</code>
            </div>
        </div>
    </div>
</div>
