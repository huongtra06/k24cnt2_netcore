@model IEnumerable<LHTRAMVC.Models.Product>
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="text-center mb-4">
    <h1 class="display-4 mb-4">Welcome to Huong Tra Bakery</h1>
    
    <!-- Banner Azure -->
    <div class="bg-primary text-white text-center p-5 rounded" style="background-color: #005A9E !important;">
        <h4 class="mb-3">Learn how Microsoft's Azure cloud platform allows you to build, deploy, and scale web apps. <a href="#" class="btn btn-light btn-sm">Learn More</a></h4>
    </div>
</div>

<h4 class="mb-3" style="color: #666;">Danh sách sản phẩm</h4>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3 text-center mb-4">
            <div class="card p-2 border-light shadow-sm h-100">
                <img src="@item.ImageUrl" class="card-img-top mx-auto" alt="@item.Name" style="max-height: 200px; object-fit: contain;">
                <div class="card-body p-2 pt-3">
                    <p class="card-text text-muted mb-0">@item.Name</p>
                </div>
            </div>
        </div>
    }
</div>